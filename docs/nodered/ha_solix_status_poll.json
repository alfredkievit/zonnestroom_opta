  {
    "id": "solix_fn_build_payload",
    "type": "function",
    "z": "solix_ha_status_tab",
    "name": "build MQTT status JSON",
    "func": "const values = msg.payload || {};\nconst requiredKeys = ['fase_1_w', 'fase_2_w', 'fase_3_w', 'totaal_w', 'fase_1_a', 'fase_2_a', 'fase_3_a', 'battery_charge_w', 'battery_discharge_w'];\nconst missing = requiredKeys.filter((key) => !Object.prototype.hasOwnProperty.call(values, key) || values[key] === null);\nconst now = Date.now();\nconst fase1 = values.fase_1_w ?? null;\nconst fase2 = values.fase_2_w ?? null;\nconst fase3 = values.fase_3_w ?? null;\nconst totaal = values.totaal_w ?? null;\nconst current1 = values.fase_1_a ?? null;\nconst current2 = values.fase_2_a ?? null;\nconst current3 = values.fase_3_a ?? null;\nconst batteryCharge = values.battery_charge_w ?? null;\nconst batteryDischarge = values.battery_discharge_w ?? null;\nfunction exportW(value) {\n  return value === null ? null : Math.max(-value, 0);\n}\nfunction importW(value) {\n  return value === null ? null : Math.max(value, 0);\n}\nconst payload = {\n  source: 'home_assistant',\n  meter: 'anker_solix_smart_meter_gen2',\n  interval_s: 5,\n  ts: new Date(now).toISOString(),\n  ts_ms: now,\n  age_ms: 0,\n  valid: missing.length === 0,\n  missing: missing,\n  sign_convention: {\n    export_to_grid: 'negative',\n    import_from_grid: 'positive'\n  },\n  values: {\n    fase_1_w: fase1,\n    fase_2_w: fase2,\n    fase_3_w: fase3,\n    totaal_w: totaal,\n    fase_1_a: current1,\n    fase_2_a: current2,\n    fase_3_a: current3,\n    battery_charge_w: batteryCharge,\n    battery_discharge_w: batteryDischarge\n  },\n  derived: {\n    export_l1_w: exportW(fase1),\n    import_l1_w: importW(fase1),\n    export_total_w: exportW(totaal),\n    import_total_w: importW(totaal),\n    battery_net_discharge_w: batteryDischarge === null || batteryCharge === null ? null : Math.max(batteryDischarge - batteryCharge, 0),\n    battery_net_charge_w: batteryDischarge === null || batteryCharge === null ? null : Math.max(batteryCharge - batteryDischarge, 0)\n  }\n};\nmsg.topic = 'homeassistant/Solix_Smartmeter/status';\nmsg.payload = payload;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 1300,
    "y": 320,
    "wires": [
      [
        "solix_mqtt_out",
        "solix_debug_out"
      ]
    ]
