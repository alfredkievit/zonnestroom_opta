  {
    "id": "fn_build_metric_requests",
    "type": "function",
    "z": "anker_modbus_tab",
    "name": "build mapped metric requests",
    "func": "const defs = [\n  { key: 'p_l1_w', topic: 'anker_smartmeter_gen2/p_l1_w', address: 0, quantity: 2, fc: 4, unitid: 1, datatype: 'float32be', scale: 1 },\n  { key: 'p_l2_w', topic: 'anker_smartmeter_gen2/p_l2_w', address: 2, quantity: 2, fc: 4, unitid: 1, datatype: 'float32be', scale: 1 },\n  { key: 'p_l3_w', topic: 'anker_smartmeter_gen2/p_l3_w', address: 4, quantity: 2, fc: 4, unitid: 1, datatype: 'float32be', scale: 1 },\n  { key: 'p_total_w', topic: 'anker_smartmeter_gen2/p_total_w', address: 6, quantity: 2, fc: 4, unitid: 1, datatype: 'float32be', scale: 1 }\n];\nreturn [defs.map(def => ({ definition: def, payload: { value: def.address, fc: def.fc, unitid: def.unitid, address: def.address, quantity: def.quantity } }))];",
    "outputs": 1,
    "noerr": 0,
    "x": 460,
    "y": 320,
    "wires": [
      [
        "split_metric_requests"
      ]
    ]
  },
  {
    "id": "split_metric_requests",
    "type": "split",
    "z": "anker_modbus_tab",
    "name": "split metric requests",
    "splt": "\\n",
    "spltType": "str",
    "arraySplt": 1,
    "arraySpltType": "len",
    "stream": false,
    "addname": "",
    "property": "payload",
