  {
    "id": "fn_normalize_probe",
    "type": "function",
    "z": "anker_modbus_tab",
    "name": "normalize raw block",
    "func": "const data = msg.payload.data || msg.payload;\nmsg.topic = 'anker_smartmeter_gen2/raw/' + msg.probeName;\nmsg.payload = {\n  probe: msg.probeName,\n  fc: msg.modbusRequest ? msg.modbusRequest.fc : undefined,\n  unitid: msg.modbusRequest ? msg.modbusRequest.unitid : undefined,\n  address: msg.modbusRequest ? msg.modbusRequest.address : undefined,\n  quantity: msg.modbusRequest ? msg.modbusRequest.quantity : undefined,\n  registers: data,\n  ts: Date.now()\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 960,
