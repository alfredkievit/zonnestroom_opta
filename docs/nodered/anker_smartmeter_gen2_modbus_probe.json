  {
    "id": "fn_decode_metric",
    "type": "function",
    "z": "anker_modbus_tab",
    "name": "decode mapped metric",
    "func": "function regsToBuffer(registers) {\n  const buf = Buffer.alloc(registers.length * 2);\n  for (let i = 0; i < registers.length; i++) {\n    buf.writeUInt16BE(registers[i] & 0xFFFF, i * 2);\n  }\n  return buf;\n}\n\nfunction decode(registers, datatype) {\n  const buf = regsToBuffer(registers);\n  switch (datatype) {\n    case 'float32be':\n      return buf.readFloatBE(0);\n    case 'float32leword': {\n      const swapped = Buffer.from([buf[2], buf[3], buf[0], buf[1]]);\n      return swapped.readFloatBE(0);\n    }\n    case 'int32be':\n      return buf.readInt32BE(0);\n    case 'uint32be':\n      return buf.readUInt32BE(0);\n    case 'int16':\n      return buf.readInt16BE(0);\n    case 'uint16':\n      return buf.readUInt16BE(0);\n    default:\n      throw new Error('Unknown datatype: ' + datatype);\n  }\n}\n\nconst def = msg.definition;\nconst registers = msg.payload.data || msg.payload;\nconst value = decode(registers, def.datatype) * (def.scale || 1);\n\nlet latest = flow.get('ankerMeterLatest') || {};\nlatest[def.key] = value;\nlatest.ts = Date.now();\nflow.set('ankerMeterLatest', latest);\n\nmsg.topic = def.topic;\nmsg.payload = value;\nmsg.metric = def.key;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 1450,
    "y": 320,
    "wires": [
      [
        "mqtt_metric_out",
        "debug_metric_ok"
      ]
    ]
  },
